<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="rtoapantaTareaS3.Views.vContacto"
             Title="Datos de contacto">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
        </Style>

        <Style TargetType="Picker">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="8">
            <Image Source="uisraellogo.png"
                   HeightRequest="120"
                   HorizontalOptions="Center" />
            <Label Text="Registro de contacto"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,0,0,12" />

            <Label Text="Tipo de identificación" />
            <Picker x:Name="TipoIdentificacionPicker"
                    Title="Seleccione el tipo" />

            <Label Text="Identificación" />
            <Entry x:Name="IdentificacionEntry"
                   Placeholder="CI, RUC o pasaporte"
                   Keyboard="Text" />

            <Label Text="Nombres" />
            <Entry x:Name="NombresEntry"
                   Placeholder="Ingrese sus nombres" />

            <Label Text="Apellidos" />
            <Entry x:Name="ApellidosEntry"
                   Placeholder="Ingrese sus apellidos" />

            <Label Text="Fecha" />
            <DatePicker x:Name="FechaPicker" />

            <Label Text="Correo" />
            <Entry x:Name="CorreoEntry"
                   Placeholder="ejemplo@correo.com"
                   Keyboard="Email" />

            <Label Text="Salario" />
            <Entry x:Name="SalarioEntry"
                   Placeholder="Ingrese el salario"
                   Keyboard="Numeric" />

            <Button Text="Resumen"
                    Clicked="OnResumenClicked"
                    Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>