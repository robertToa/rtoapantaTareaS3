<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="rtoapantaTareaS3.Views.vResumen"
             Title="Resumen">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Resumen de datos"
                   FontSize="24"
                   FontAttributes="Bold"
                   Margin="0,0,0,12" />

            <Label x:Name="TipoIdentificacionLabel" />
            <Label x:Name="IdentificacionLabel" />
            <Label x:Name="NombresLabel" />
            <Label x:Name="ApellidosLabel" />
            <Label x:Name="FechaLabel" />
            <Label x:Name="CorreoLabel" />
            <Label x:Name="SalarioLabel" />
            <Label x:Name="IessLabel" />

            <Button Text="Exportar resumen a TXT"
                    Clicked="OnExportarClicked"
                    Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>